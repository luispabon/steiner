# Experimental settings. Copy to .env and load with direnv (dotenv_if_exists). steiner does not read .env itself.

# Enable immutable summary segment compaction (#1042).
STEINER_EXPERIMENT_SEGMENTED_COMPACTION=0

# Maximum number of immutable summary segments in a chain, 1..64.
STEINER_EXPERIMENT_SEGMENT_MAX_COUNT=8

# Segment chain cap as a percentage of the compaction budget, (0, 100].
STEINER_EXPERIMENT_SEGMENT_MAX_CHAIN_PERCENT=12.5

# Cap on projected post-append tokens as a percentage of the compaction budget, (0, 100].
STEINER_EXPERIMENT_SEGMENT_MAX_POST_PERCENT=50
